<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: fake media session for testing Now Playing.
             adb shell am broadcast -n nl.julian.aerial/.debug.FakeMediaReceiver -a play|pause|stop -->
        <receiver
            android:name=".debug.FakeMediaReceiver"
            android:exported="true" />
        <!-- Debug builds only, off by default: a fake TV input for the input switcher on an emulator. -->
        <service
            android:name=".debug.FakeTvInputService"
            android:enabled="false"
            android:exported="true"
            android:label="Test input (debug)"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/fake_tv_input" />
        </service>
    </application>
</manifest>
